generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String   @id @default(uuid())
  email              String   @unique
  googleAccessToken  String?
  googleRefreshToken String?
  hubspotAccessToken String?
  hubspotRefreshToken String?
  createdAt          DateTime @default(now())
  embeddings         Embedding[]
  tasks              Task[]
  memories           Memory[]
}

model Embedding {
  id        String   @id @default(uuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  source    String
  content   String
  metadata  Json
  vector    Unsupported("vector")
  createdAt DateTime @default(now())
}

model Task {
  id        String   @id @default(uuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  type      String
  state     String
  payload   Json
  result    Json?
  createdAt DateTime @default(now())
}

model Memory {
  id          String   @id @default(uuid())
  user        User     @relation(fields: [userId], references: [id])
  userId      String
  instruction String
  createdAt   DateTime @default(now())
}

// pgvector extension - handled via raw SQL
